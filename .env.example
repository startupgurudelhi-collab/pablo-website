# Server Configuration
PORT=3000
NODE_ENV=production
APP_URL="https://yourdomain.com"
CORS_ORIGIN=""

# Hostinger MySQL Database Configuration
# Leave MYSQL_DATABASE and MYSQL_USER blank for local JSON fallback in development.
MYSQL_HOST="127.0.0.1"
MYSQL_PORT=3306
MYSQL_DATABASE=""
MYSQL_USER=""
MYSQL_PASSWORD=""
MYSQL_SSL="false"

# Persistent Storage Paths (keep outside dist/ so rebuilds do not wipe uploads)
DATA_DIR="./data"
MEDIA_DIR="./storage/media"

# Initial Admin Credentials (set strong credentials BEFORE first server start)
ADMIN_EMAIL="admin@pablo.studio"
ADMIN_PASSWORD="change-me-in-production"

# Session Signing Secret (generate a strong 32+ char random secret in production)
SESSION_SECRET=""
